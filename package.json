{
  "name": "mcp-zh-registry",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A Chinese-translated mirror of the official MCP registry. Ships as static catalog files in git (no server needed) and optionally as a Cloudflare Worker speaking the same paginated registry protocol.",
  "scripts": {
    "fetch": "node generator/step1-fetch.js",
    "sample": "node generator/step2-sample.js",
    "translate": "node generator/step3-sql.js",
    "sql": "node generator/step3-sql.js --chunk=8000",
    "catalog": "node generator/build-catalog.js",
    "measure": "node generator/measure-catalog.js",
    "update": "node generator/update.js",
    "verify": "node generator/step4-verify.js",
    "test": "node test/catalog.js && node test/e2e.js",
    "test:catalog": "node test/catalog.js",
    "test:e2e": "node test/e2e.js",
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy"
  },
  "engines": {
    "node": ">=22.5"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
